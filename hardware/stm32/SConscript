Import('app_env', 'gen_secrets_action')

stm32_env = app_env.Clone()

stm32_env.Replace(CC='arm-none-eabi-gcc')
stm32_env.Replace(AR='arm-none-eabi-ar')
stm32_env.Replace(AS='arm-none-eabi-as')

stm32_env["arch_flags"]=[
    '-mcpu=cortex-m4',
    '-mthumb',
    '-mfpu=fpv4-sp-d16',
    '-mfloat-abi=hard'
]

# STM32-specific flags
stm32_env.Append(CPPFLAGS=
    stm32_env["arch_flags"] + [
    '-ffunction-sections',
    '-fdata-sections',
    '-Wall',
])

# STM32-specific defines
stm32_env.Append(CPPDEFINES=[
    'USE_HAL_DRIVER',
    'STM32F411xE'
])

# STM32-specific include paths
stm32_env.Append(CPPPATH=[
    '#/hardware/stm32/Core/Inc',
    '#/hardware/stm32/Drivers/STM32F4xx_HAL_Driver/Inc',
    '#/hardware/stm32/Drivers/STM32F4xx_HAL_Driver/Inc/Legacy',
    '#/hardware/stm32/Drivers/CMSIS/Device/ST/STM32F4xx/Include',
    '#/hardware/stm32/Drivers/CMSIS/Include'
])

# STM32 sources
sources = Glob('Core/Src/*.c')
sources.append('startup_stm32f411xe.s')

import platform

# Platform-specific linker flags (ARM GNU toolchain)
if platform.system() == 'Darwin':  # macOS
    # Some macOS ARM toolchains may have linker differences
    linkflags = stm32_env["arch_flags"] + [
        '-T', 'hardware/stm32/STM32F411XX_FLASH.ld',
        '-Wl,-dead_strip',  # macOS equivalent of --gc-sections
        f'-Wl,-map,{stm32_env["build_dir"]}/STM32.map',
        '-specs=nano.specs'
    ]
else:  # Linux and other Unix-like systems
    linkflags = stm32_env["arch_flags"] + [
        '-T', 'hardware/stm32/STM32F411XX_FLASH.ld',
        '-Wl,--gc-sections',
        f'-Wl,-Map={stm32_env["build_dir"]}/STM32.map,--cref',
        '-specs=nano.specs'
    ]

stm32_env.Append(LINKFLAGS=linkflags)

stm32_env.Append(LIBS=[
    'c',
    'm',
    'nosys'
])

secrets_h = stm32_env.Command(
    target=['secrets.h'],
    source=[],
    action=gen_secrets_action
)

driver_objects = SConscript(
    'Drivers/SConscript',
    variant_dir='drivers',
    duplicate=0,
    exports={'env': stm32_env}
)

aes_lib = SConscript(
    '#/libraries/tiny-AES-c/SConscript',
    variant_dir='libraries/tiny-AES-c',
    duplicate=0,
    exports={'env': stm32_env}
)

aes_cmac_lib = SConscript(
    '#/libraries/tiny-AES-CMAC-c/SConscript',
    variant_dir='libraries/tiny-AES-CMAC-c',
    duplicate=0,
    exports={'env': stm32_env}
)

# Build application with our architecture-specific environment
app_objects = SConscript(
    '#/application/SConscript',
    variant_dir='application',  # Relative to current variant_dir
    duplicate=0,
    exports={'env': stm32_env}  # Pass our configured environment
)

app = stm32_env.Program(f'{stm32_env["name"]}.elf', sources + app_objects + driver_objects + aes_lib + aes_cmac_lib)
stm32_env.Depends(app, secrets_h)

Return('app')