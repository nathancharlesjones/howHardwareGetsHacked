Import('app_env', 'gen_secrets_action', 'secrets_h_sources')

tm4c_env = app_env.Clone()

tm4c_env.Append(CPPFLAGS=[
    '-std=c99'
])

# TM4C-specific defines
tm4c_env.Append(CPPDEFINES=[
    'PART_TM4C123GH6PM',
    'TARGET_IS_TM4C123_RB1',
    'gcc'
])

# TM4C-specific include paths
tm4c_env.Append(CPPPATH=[
    '#/hardware/tm4c/libraries/tivaware'
])

# TM4C sources
sources = [
    'source/tm4c.c',
    'source/uart_tm4c.c',
    'source/syscalls.c',
    'libraries/tivaware/startup_tm4c123gh6pm_baremetal.c'
]

if tm4c_env["role"] == "car":
    sources.append('source/prng_tm4c.c')

import platform

# Platform-specific linker flags (using ld directly)
if platform.system() == 'Darwin':  # macOS
    # Some macOS ARM toolchains may have linker differences
    linkflags = [
        '-T', 'hardware/tm4c/libraries/tivaware/firmware.ld',
        '-dead_strip',  # macOS ld equivalent of --gc-sections
        f"-map={tm4c_env['build_dir']}/TM4C.map"
    ]
else:  # Linux and other Unix-like systems
    linkflags = [
        '-T', 'hardware/tm4c/libraries/tivaware/firmware.ld',
        '--gc-sections',
        f"-Map={tm4c_env['build_dir']}/TM4C.map"
    ]

tm4c_env.Append(LINKFLAGS=linkflags)

secrets_h = tm4c_env.Command(
    target=['secrets.h'],
    source=secrets_h_sources(tm4c_env),
    action=gen_secrets_action
)
tm4c_env.AlwaysBuild(secrets_h)

driver_objects = SConscript(
    'libraries/SConscript',
    variant_dir='drivers',
    duplicate=0,
    exports={'env': tm4c_env}
)

aes_lib, aes_cmac_lib = app_env['platform_libs']

# Build application with our architecture-specific environment
app_objects = SConscript(
    '#/application/SConscript',
    variant_dir='application',  # Relative to current variant_dir
    duplicate=0,
    exports={'env': tm4c_env}  # Pass our configured environment
)

# Find exact library paths
import subprocess
import os

libgcc_path = subprocess.check_output(
    ['arm-none-eabi-gcc'] + tm4c_env['arch_flags'] + ['-print-file-name=libgcc.a']
).decode().strip()

libc_path = subprocess.check_output(
    ['arm-none-eabi-gcc'] + tm4c_env['arch_flags'] + ['-print-file-name=libc.a']
).decode().strip()

libm_path = subprocess.check_output(
    ['arm-none-eabi-gcc'] + tm4c_env['arch_flags'] + ['-print-file-name=libm.a']
).decode().strip()

'''
print(f"Using libraries:")
print(f"  libgcc: {libgcc_path}")
print(f"  libc:   {libc_path}")
print(f"  libm:   {libm_path}")
'''

# Explicit library files
libs = [
    libm_path,   # Math library
    libc_path,   # C library  
    libgcc_path, # GCC runtime
]

app = tm4c_env.Program(f'{tm4c_env["name"]}.elf', sources + app_objects + driver_objects + [app_env['platform_common_obj']] + aes_lib + aes_cmac_lib + libs)
tm4c_env.Depends(app, secrets_h)

Return('app')