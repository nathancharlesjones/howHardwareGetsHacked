Import('app_env', 'gen_secrets_action')

sim_env = app_env.Clone()

# sim-specific include paths
sim_env.Append(CPPPATH=[
    '#/hardware/sim/include',
    '#/hardware/sim/ui'
])

# sim sources
sources = [
    'source/sim.c',
    'source/uart_sim.c',
]

ui = sim_env.get('ui')
if ui:
    sources.append(f"ui/{ui}/{ui}_sim.c")

import platform

# Platform-specific linker flags
if platform.system() == 'Darwin':  # macOS
    # macOS uses LLVM ld which has different flags
    sim_env.Append(LINKFLAGS = [
        '-Wl,-dead_strip',  # Remove unused code (like --gc-sections)
        f'-Wl,-map,{sim_env["build_dir"]}/sim.map'  # Generate map file
    ])
else:  # Linux and other Unix-like systems
    # Use GNU ld flags
    sim_env.Append(LINKFLAGS = [
        '-Wl,--gc-sections',
        f'-Wl,-Map={sim_env["build_dir"]}/sim.map,--cref'
    ])

sim_env.Append(LIBS=[
    'm',
    'pthread'
])

secrets_h = sim_env.Command(
    target='secrets.h',
    source=['#secrets/car_secrets.json'],
    action=gen_secrets_action
)

# Build application with our architecture-specific environment
app_objects = SConscript(
    '#/application/SConscript',
    variant_dir='application',  # Relative to current variant_dir
    duplicate=0,
    exports={'env': sim_env}  # Pass our configured environment
)

app = sim_env.Program(f'{sim_env["name"]}', app_objects + sources)
sim_env.Depends(app, secrets_h)

Return('app')